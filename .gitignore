# ─────────────────────────────────────────────────────────────
# CoachOS
# See CLAUDE.md §21 — no secrets in the repo, ever.
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
apps/*/node_modules/
packages/*/node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ── Environment & secrets ─────────────────────────────────────
# Broad by design. `.env.example` is the ONLY env file that may
# ever be committed, and it must contain placeholders only.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
google-services.json
GoogleService-Info.plist
service-account*.json
credentials.json
secrets.json

# ── Native folders — regenerated by CNG (CLAUDE.md §25.3) ─────
# Never edit these; never commit them. Config lives in app.config.ts.
/ios/
/android/
apps/*/ios/
apps/*/android/
.kotlin/
*.orig.*

# ── Expo / EAS ────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
next-env.d.ts
.easignore

# ── Build output & caches ─────────────────────────────────────
build/
.turbo/
.next/
out/
*.tsbuildinfo
.metro-health-check*
.cache/
.parcel-cache/

# ── Tests, coverage, artifacts ────────────────────────────────
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
.maestro/tests/**/screenshots/
*.hprof

# ── Logs & crash dumps ────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
lerna-debug.*
*.stackdump
bash.exe.stackdump

# ── Local database & scratch ──────────────────────────────────
*.sqlite
*.sqlite3
*.db-journal
/tmp/
scratch/
.scratchpad/

# ── Editor & OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# ── Claude Code ───────────────────────────────────────────────
# The planning tree and the skills are deliberately local-only.
.claude/plan/
.claude/skills/
.claude/settings.local.json
.claude/projects/
.claude/todos/

# ── Specification documents — local only ──────────────────────
# Deliberately not published. CLAUDE.md, README.md, LICENSE and
# docs/ remain committed; these twelve do not.
# NOTE: adding a path here does not untrack it. Anything already
# committed needs `git rm --cached <path>` as well.
# AGENTS.md is anchored to the repo root (/AGENTS.md) deliberately — Next.js
# auto-generates its own apps/web/AGENTS.md tooling-guidance file and
# explicitly asks to have it committed; a bare pattern here would swallow
# that unrelated file too.
/AGENTS.md
ANALYTICS.md
ARCHITECTURE.md
ARCHITECTURE-ESSENTIALS.md
COMPLIANCE.md
COPY.md
DATABASE.md
DESIGN-SYSTEM.md
ERRORS.md
OBSERVABILITY.md
SUPPORT.md
UI-UX.md

# ── Misc ──────────────────────────────────────────────────────
example

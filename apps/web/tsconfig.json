{
  "extends": "@coachos/config/tsconfig.base.json",
  // Next's required TypeScript config — only what Next itself demands
  // (jsx, moduleResolution, the next plugin, next-env.d.ts).
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    // Same arrangement as apps/api and packages/schemas: this tsconfig is
    // both the build config and the typecheck config, so the test globals
    // have to be declared here or `*.test.tsx` fails `tsc --noEmit`
    // (guardian-consent/05). React's own types are reached by module
    // resolution and by next-env.d.ts's triple-slash reference, neither of
    // which this list constrains.
    "types": ["node", "jest"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

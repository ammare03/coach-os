# apps/web — server-side only. Nothing here is prefixed NEXT_PUBLIC_, so
# nothing here reaches the browser bundle. See the `configuration` skill §3.
#
# .env is gitignored; this file is committed with every key present, so a
# fresh clone knows what it needs.

# The origin of apps/api, read server-side by
# app/guardian-consent/[token]/confirm.ts and by nothing else. The tRPC
# mount path (/trpc) is appended by that module — set the origin only, with
# no trailing slash and no path.
#
# This is deliberately neither of the two API URLs that already exist:
#   EXPO_PUBLIC_API_URL  is apps/mobile's, and is public by design
#   APP_PUBLIC_URL       is apps/api's, and points the other way — it is the
#                        https origin apps/api builds emailed links from,
#                        i.e. this app
WEB_API_URL=http://localhost:3000

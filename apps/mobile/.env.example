# Copy to .env and fill in local values. Never commit a real value here —
# .env is gitignored; this file (.env.example) is the only env file that
# may ever be committed, and only with placeholders.
#
# Every variable below is prefixed EXPO_PUBLIC_, which means Expo compiles
# it directly into the shipped JavaScript bundle. Anyone who downloads the
# app can extract it. See the `configuration` skill §3 before adding a
# new EXPO_PUBLIC_ variable — a server secret must never carry this prefix.

# Your machine's LAN IP, not localhost — a phone on the same network
# cannot reach your computer's localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

EXPO_PUBLIC_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# Write-only PostHog ingestion key — safe to expose by design.
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key

# Public Sentry DSN — safe to expose by design.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Public RevenueCat SDK keys — not the secret API key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_public_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_public_sdk_key

# Google Sign In OAuth client ids (social-sign-in/02) — public by nature,
# not secrets: an iOS/Android OAuth client type has no client secret at all.
# These are the client-side counterpart to the server's
# GOOGLE_SIGN_IN_CLIENT_IDS (apps/api/.env.example) — same two values,
# split across two files because one is bundled public and one is a
# server-only audience check.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Opt the component gallery (`/_dev/gallery`) into a RELEASE bundle. Unset
# in every normal case: the gallery ships automatically in development
# bundles and `metro.config.js` blocks its files whenever NODE_ENV is
# production. Set it to `1` only on an internal preview build you want to
# review the design system on, and NEVER in the production build profile.
EXPO_PUBLIC_DEV_GALLERY=

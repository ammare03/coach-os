{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --experimental-strip-types src/index.ts",
    "worker": "node --watch --env-file=.env --experimental-strip-types src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@aws-sdk/lib-storage": "3.1124.0",
    "@aws-sdk/s3-request-presigner": "3.1124.0",
    "@coachos/db": "workspace:*",
    "@coachos/schemas": "workspace:*",
    "@coachos/utils": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@node-rs/argon2": "^2.2.0",
    "@react-email/components": "1.0.12",
    "@sentry/node": "10.73.0",
    "@trpc/server": "11.18.0",
    "archiver": "8.0.0",
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "postgres": "3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.25.0",
    "superjson": "2.2.6",
    "uuidv7": "1.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@coachos/config": "workspace:*",
    "@types/archiver": "8.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jest": "30.5.1",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "~7.0.2"
  }
}

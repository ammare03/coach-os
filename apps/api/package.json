{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --experimental-strip-types src/index.ts",
    "worker": "node --watch --env-file=.env --experimental-strip-types src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "jest"
  },
  "dependencies": {
    "@coachos/db": "workspace:*",
    "@coachos/schemas": "workspace:*",
    "@coachos/utils": "workspace:*",
    "@hono/node-server": "2.1.1",
    "@node-rs/argon2": "^2.1.0",
    "@react-email/components": "1.0.12",
    "@sentry/node": "10.70.0",
    "@trpc/server": "11.18.0",
    "bullmq": "6.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "postgres": "3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.22.1",
    "superjson": "1.13.3",
    "uuidv7": "1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@coachos/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jest": "30.4.2",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "~6.0.3"
  }
}

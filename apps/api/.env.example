# Copy to .env and fill in local values. Never commit a real value here —
# .env is gitignored; this file (.env.example) is the only env file that
# may ever be committed, and only with placeholders.
#
# Every variable here is server-only. NEVER prefix a server secret with
# EXPO_PUBLIC_ — that prefix means "compiled into the mobile bundle and
# readable by anyone who downloads the app". See the `configuration` skill.
#
# Real values live in Fly secrets at runtime, never in git.

NODE_ENV=development
PORT=3000

# Postgres 16 (Neon in dev, RDS in prod). CLAUDE.md §3.2.
DATABASE_URL=postgres://user:password@localhost:5432/coachos

# Redis (Upstash). Cache, queues, rate limits.
REDIS_URL=redis://localhost:6379

# Prepended to every Redis key (DATABASE.md DB§15) so dev/preview/prod can
# share one free-tier instance without colliding. One of coachos:dev:,
# coachos:preview:, coachos:prod: per CLAUDE.md §3.4.3.
REDIS_KEY_PREFIX=coachos:dev:

# Access token / refresh token signing secrets. CLAUDE.md §21.2 — access
# token 15 min, refresh token 30 days with rotation + reuse detection.
JWT_SECRET=replace-with-a-long-random-value
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-value

# Social sign-in: the expected audience on an Apple/Google identity token
# (auth-server/01). Not secret, but required so a wrong client id fails at
# boot rather than rejecting every social sign-in silently.
APPLE_SIGN_IN_CLIENT_ID=com.coachos.app
GOOGLE_SIGN_IN_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Cloudflare R2 (S3-compatible object storage). Zero egress fees.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=coachos-media

# LiveKit (self-hosted or cloud free tier). Server API credentials — never
# the same as the client-side EXPO_PUBLIC_LIVEKIT_URL.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# RevenueCat — coach subscription webhooks and server API.
REVENUECAT_SECRET_API_KEY=your-revenuecat-secret-api-key
REVENUECAT_WEBHOOK_AUTH_HEADER=your-revenuecat-webhook-auth-header

# Stripe — Phase-3 web dashboard checkout and Agency invoicing only.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Resend — transactional email.
RESEND_API_KEY=your-resend-api-key

# Anthropic API — Phase-3 AI assistant only, gated to Pro+ with a per-coach
# generation cap. CLAUDE.md §3.4.4, §15.2.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Open Food Facts requires a descriptive User-Agent identifying this app —
# no API key, but a missing/generic User-Agent risks being rate-limited.
OPEN_FOOD_FACTS_USER_AGENT=CoachOS/1.0 (contact@coachos.app)

# Sentry — source map upload during the EAS build hook.
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Sentry — server-side error capture (observability/02-sentry-integration.md).
# Optional: leave unset for local development and CI. The DSN itself is not
# a secret (Sentry's own design — it's the write-only ingestion endpoint),
# but it lives here rather than a mobile EXPO_PUBLIC_ var because this is
# the API's own, separate Sentry project.
SENTRY_DSN=

# Metrics/alerts cron trigger (observability/06-metrics-and-alerts.md). The
# shared secret `.github/workflows/metrics-cron.yml` sends on
# POST /internal/metrics/collect — this is machine-to-machine, not a user
# session, so it's a bearer secret rather than an operator login.
INTERNAL_JOB_SECRET=replace-with-a-long-random-value

# Where the five P1 alerts get delivered (../lib/alerts.ts). Both optional —
# leave unset for local dev/CI; alerts log instead of sending when either is
# missing.
ALERTS_EMAIL_TO=
ALERTS_EXPO_PUSH_TOKEN=

# OB§4.4 — tightens alert thresholds during the ship-gate-1 pilot. Unset/false
# outside the pilot window.
PILOT_MODE=false

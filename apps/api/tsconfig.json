{
  "extends": "@coachos/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // React Email templates only (`src/lib/email/`, auth-server/06) —
    // rendered server-side to a string via `@react-email/render`, never
    // shipped to a client. Not a step toward a DOM/React Native runtime in
    // this app.
    "jsx": "react-jsx",

    // Source imports write the real .ts extension (Node's --experimental-strip-types
    // dev runner needs the literal file on disk); tsc rewrites it to .js in the
    // emitted output so the built dist/ still resolves correctly under Node's ESM.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // "jest" is needed for src/__tests__/**.test.ts to typecheck — this
    // tsconfig doubles as both the build config and the typecheck config
    // (quality-gates/01).
    "types": ["node", "jest"],

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}

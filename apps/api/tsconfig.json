{
  "extends": "@coachos/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Source imports write the real .ts extension (Node's --experimental-strip-types
    // dev runner needs the literal file on disk); tsc rewrites it to .js in the
    // emitted output so the built dist/ still resolves correctly under Node's ESM.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}

#!/usr/bin/env sh
# quality-gates/02. Three checks, in order: format+lint the staged files,
# then the secret scan, then the generated-native-directory guard. Keep this
# whole file fast (§Approach 6) — a slow hook trains `--no-verify` reflexes,
# and the secret scan is the one check that must never get skipped that way.

npx lint-staged || exit 1

sh scripts/check-secrets.sh || exit 1

# ios/ and android/ are generated by CNG (`npx expo prebuild`) and must never
# enter history — .gitignore already excludes them, but `git add -f` bypasses
# that (git-workflow skill §5, CLAUDE.md §25.3).
native_files="$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)(ios|android)/' || true)"
if [ -n "$native_files" ]; then
  echo "✗ ios/ and android/ are generated by CNG and must never be committed:"
  echo "$native_files" | sed 's/^/    /'
  exit 1
fi

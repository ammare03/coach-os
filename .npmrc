# Metro (React Native's bundler) does not reliably follow pnpm's default
# symlinked node_modules layout. A flat, hoisted tree avoids resolution
# failures that otherwise look like missing modules. See CLAUDE.md §3.1
# and .claude/plan/phase-00-repository-foundation/workspace-scaffold/01-workspace-skeleton.md.
node-linker=hoisted

# The React Native ecosystem's peer-dependency ranges are perpetually
# slightly behind. Strict peer checking blocks installs for no real benefit.
strict-peer-dependencies=false

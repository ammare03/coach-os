{
  "name": "coach-os",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "prettier": "@coachos/config/prettier.json",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@coachos/db",
    "db:migrate": "turbo run db:migrate --filter=@coachos/db",
    "db:studio": "turbo run db:studio --filter=@coachos/db",
    "db:seed": "turbo run db:seed --filter=@coachos/db",
    "db:seed:demo": "turbo run db:seed:demo --filter=@coachos/db"
  },
  "devDependencies": {
    "@coachos/config": "workspace:*",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}

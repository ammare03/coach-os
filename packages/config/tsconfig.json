{
  "extends": "@coachos/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "types/**/*.d.ts",
    "*.js",
    "eslint-rules/**/*.js",
    "jest-doubles/**/*.js",
    "tailwind/**/*.js"
  ]
}

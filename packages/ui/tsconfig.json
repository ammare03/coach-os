{
  "extends": "@coachos/config/tsconfig.base.json",
  // Mirrors the React Native-relevant options from expo/tsconfig.base
  // directly, rather than extending it — packages/ui depends on React
  // Native only as a peer, never on the `expo` package itself.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Same reason as `apps/mobile`/`apps/api`'s tsconfig: every relative
    // import in this repo writes the real `.ts`/`.tsx` extension on disk
    // (CLAUDE.md §17.1 `verbatimModuleSyntax`), and tsc needs this flag to
    // resolve those literally under `noEmit`.
    "allowImportingTsExtensions": true,
    // Needed for `*.test.tsx` to typecheck (mirrors `apps/mobile/tsconfig.json`).
    "types": ["jest"]
  },
  "include": ["src"]
}

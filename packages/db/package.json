{
  "name": "@coachos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@coachos/config": "workspace:*",
    "@types/node": "22.20.1",
    "drizzle-kit": "0.31.10",
    "typescript": "~6.0.3"
  }
}

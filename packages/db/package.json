{
  "name": "@coachos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate && node --env-file-if-exists=.env --experimental-strip-types scripts/list-updated-at-tables.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types src/seed.ts",
    "db:seed:demo": "node --env-file-if-exists=.env --experimental-strip-types src/seed.ts --demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@coachos/config": "workspace:*",
    "@faker-js/faker": "10.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "drizzle-kit": "0.31.10",
    "jest": "30.5.1",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "~7.0.2"
  }
}

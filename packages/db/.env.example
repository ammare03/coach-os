# Copy to .env and fill in local values. Never commit a real value here —
# .env is gitignored; this file is the only env file that may ever be
# committed, and only with placeholders.
#
# Used by drizzle-kit (drizzle.config.ts) and by db:seed / db:migrate run
# directly against this package. apps/api reads its own copy of this value
# through apps/api/src/env.ts — this file exists so packages/db's scripts
# are runnable on their own, without the API process.

# Matches packages/db/docker-compose.yml's local Postgres 16.
DATABASE_URL=postgres://coachos:coachos@localhost:5432/coachos # secret-scan-ignore
